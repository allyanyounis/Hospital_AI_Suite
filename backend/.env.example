# Copy to .env and fill in. Never commit .env.

# PostgreSQL (scripts/setup-db.ps1 creates the role and database and writes this line for you)
DATABASE_URL=postgresql+psycopg://hospital_ai:CHANGE_ME@localhost:5432/hospital_ai

# Signs login sessions. Required before any pilot use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- AI medical scribe ---
DEEPGRAM_API_KEY=
# "claude" (needs ANTHROPIC_API_KEY) or "ollama" (local, no key; also set OLLAMA_MODEL)
NOTE_PROVIDER=claude
ANTHROPIC_API_KEY=

# --- AI voice receptionist ---
# Same value as the "Secret" set on your VAPI assistant's server URL; webhooks without it are rejected
VAPI_SECRET=
# CLINIC_TIMEZONE=Asia/Karachi
# BOOKING_WINDOW_DAYS=10

# --- Governance (defaults shown) ---
# RETENTION_DAYS=7                 scribe transcripts/notes erased after this; metrics kept
# SECURE_COOKIES=false             true when served over HTTPS
# SESSION_HOURS=12
# ENVIRONMENT_BANNER=Pilot environment · synthetic data only
# CORS_ORIGINS=["http://localhost:3004"]
# BASELINE_MINUTES_PER_NOTE=16

# --- Optional model overrides ---
# NOTE_MODEL=claude-opus-5-5
# NOTE_EFFORT=low
# REVIEW_EFFORT=medium
# OLLAMA_MODEL=qwen3:14b
# DEEPGRAM_MODEL=nova-3-medical
