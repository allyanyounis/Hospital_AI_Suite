# Copy to .env and fill in. Never commit .env.

# PostgreSQL. `docker compose up -d db` (repo root) runs it; scripts/setup.ps1 writes this line for you.
# Use 127.0.0.1 rather than localhost: on Windows localhost tries IPv6 first and the container listens on IPv4.
DATABASE_URL=postgresql+psycopg://hospital_ai:CHANGE_ME@127.0.0.1:5432/hospital_ai

# Signs login sessions. Required before any pilot use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- AI medical scribe ---
DEEPGRAM_API_KEY=
# "claude" (needs ANTHROPIC_API_KEY), "groq" (needs GROQ_API_KEY) or "ollama" (local, no key; also set OLLAMA_MODEL)
NOTE_PROVIDER=claude
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Hospital ---
# Shown in the app header, sign-in page and API title
HOSPITAL_NAME=Hospital AI Suite

# --- AI voice receptionist ---
# Same value as the "Secret" set on your VAPI assistant's server URL; webhooks without it are rejected
VAPI_SECRET=
# HOSPITAL_TIMEZONE=Asia/Karachi
# BOOKING_WINDOW_DAYS=10

# --- Governance (defaults shown) ---
# RETENTION_DAYS=7                 scribe transcripts/notes erased after this; metrics kept
# SECURE_COOKIES=false             true when served over HTTPS
# SESSION_HOURS=12
# ENVIRONMENT_BANNER=Pilot environment · synthetic data only
# CORS_ORIGINS=["http://localhost:3004"]
# BASELINE_MINUTES_PER_NOTE=16

# --- Optional model overrides ---
# NOTE_MODEL=claude-opus-5-5
# NOTE_EFFORT=low
# REVIEW_EFFORT=medium
# OLLAMA_MODEL=qwen3:14b
# DEEPGRAM_MODEL=nova-3-medical
