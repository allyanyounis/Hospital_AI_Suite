# Copy to .env.local (never committed). Restart `npm run dev` after editing; NEXT_PUBLIC_* values are baked in at build.

# --- Browser-visible (read only in src/config/env.ts) ---
# VAPI voice agent: the PUBLIC key and assistant id from the VAPI dashboard. Leave empty to disable the voice agent.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# WebSockets (live transcription, live booking events) go straight to the backend, not through the Next proxy.
# Full base URL when the backend is on another host or behind HTTPS, e.g. wss://api.hospital.example
# NEXT_PUBLIC_BACKEND_WS_URL=
# Otherwise the page's own host is used with this port
# NEXT_PUBLIC_BACKEND_PORT=8000

# --- Server-only (read in next.config.ts) ---
# Where the Next server proxies /api/* (keeps the session cookie first-party, so no CORS)
# BACKEND_URL=http://localhost:8000
