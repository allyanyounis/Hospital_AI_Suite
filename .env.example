# Copy to .env (repo root). Read by `docker compose` for the PostgreSQL container. Never commit .env.
# Postgres applies these only when the data volume is first created; `docker compose down -v` resets it.
POSTGRES_USER=hospital_ai
POSTGRES_PASSWORD=hospital_ai
POSTGRES_DB=hospital_ai
POSTGRES_PORT=5432

# backend/.env DATABASE_URL must match:
#   postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:<POSTGRES_PORT>/<POSTGRES_DB>
