# =============================================================================
# Aramis AI Healthcare Solutions — Environment Configuration Template
# Copy this file to .env and fill in environment-specific credentials.
# NEVER commit .env to version control.
# =============================================================================

# --- Platform Brand Identity ---
BRAND_NAME="Aramis AI Healthcare Solutions"
BRAND_SHORT_NAME="Aramis Health"
BRAND_TAGLINE="Intelligent Multi-Hospital Clinical Operating System"

# --- Core Flask Application ---
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change-me-to-a-secure-random-64-char-string-in-production
BIND_ALL_INTERFACES=false
DISABLE_SCHEDULER=false
STATIC_ASSET_VERSION=20261103

# --- Session & Security ---
PERMANENT_SESSION_LIFETIME_DAYS=7
SESSION_COOKIE_SECURE=false
# SSL_CERT=
# SSL_KEY=

# --- PostgreSQL 16 + pgvector (Container / Superuser for Migrations) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=quickcare_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_superuser_password
# Superuser connection used solely for Alembic migrations and role provisioning:
DATABASE_URL=postgresql://postgres:your_postgres_superuser_password@127.0.0.1:5432/quickcare_dev
DEV_DATABASE_URL=postgresql://postgres:your_postgres_superuser_password@127.0.0.1:5432/quickcare_dev
MIGRATION_DATABASE_URL=postgresql://postgres:your_postgres_superuser_password@127.0.0.1:5432/quickcare_dev

# --- Non-Superuser Multi-Tenant RLS Database Roles ---
# aramis_app: Standard runtime connection (NOBYPASSRLS, tenant isolation enforced)
ARAMIS_APP_PASSWORD=your_aramis_app_password
APP_DATABASE_URL=postgresql://aramis_app:your_aramis_app_password@127.0.0.1:5432/quickcare_dev

# aramis_platform: Platform Super Admin connection (BYPASSRLS, audit & cross-tenant governance)
ARAMIS_PLATFORM_PASSWORD=your_aramis_platform_password
PLATFORM_DATABASE_URL=postgresql://aramis_platform:your_aramis_platform_password@127.0.0.1:5432/quickcare_dev

# --- Testing Databases ---
TESTING=False
TEST_DATABASE_URL=postgresql://postgres:your_postgres_superuser_password@127.0.0.1:5432/quickcare_test
APP_TEST_DATABASE_URL=postgresql://aramis_app:your_aramis_app_password@127.0.0.1:5432/quickcare_test

# --- Agora Video Consultation (RTC) ---
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_API_BASE=https://api.sd-rtn.com/v1/apps

# --- Agora Cloud Recording (Optional) ---
AGORA_ENABLE_RECORDING=false
AGORA_CUSTOMER_ID=your_agora_customer_id
AGORA_CUSTOMER_SECRET=your_agora_customer_secret
AGORA_RECORDING_STORAGE_VENDOR=11
AGORA_RECORDING_STORAGE_REGION=0
AGORA_RECORDING_STORAGE_BUCKET=your_recording_bucket
AGORA_RECORDING_STORAGE_ACCESS_KEY=your_recording_access_key
AGORA_RECORDING_STORAGE_SECRET_KEY=your_recording_secret_key
AGORA_RECORDING_STORAGE_ENDPOINT=https://sgp1.digitaloceanspaces.com
AGORA_RECORDING_FILE_PREFIX=recordings

# --- DigitalOcean Spaces / S3 Compatible Storage ---
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=your_spaces_bucket
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY=your_spaces_access_key
DO_SPACES_SECRET_KEY=your_spaces_secret_key
DO_SPACES_PRESIGN_EXPIRES=3600

# --- Safepay Payment Gateway (Sandbox / Production) ---
SAFEPAY_API_KEY=sec_sandbox_placeholder
SAFEPAY_SECRET_KEY=sec_sandbox_placeholder
SAFEPAY_BASE_URL=https://sandbox.api.getsafepay.com
SAFEPAY_CHECKOUT_URL=https://sandbox.api.getsafepay.com
SAFEPAY_ENVIRONMENT=sandbox

# --- AI Chatbot & Knowledge Assistant ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://127.0.0.1:5000
OPENROUTER_APP_TITLE="Aramis Health AI"

# --- Maps & Doctor Practice Geocoding ---
GEOAPIFY_API_KEY=your_geoapify_api_key
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Email Notifications (SMTP) ---
ENABLE_EMAILS=false
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=noreply@aramis.health
MAIL_PASSWORD=your_mail_password
MAIL_DEFAULT_SENDER_NAME="Aramis Health"
MAIL_DEFAULT_SENDER_EMAIL=noreply@aramis.health

# --- Super Admin Initial Provisioning ---
ADMIN_EMAIL=superadmin@aramis.health
ADMIN_PASSWORD=your_initial_admin_password

# --- Hospital & Clinical Business Rules ---
PLATFORM_COMMISSION_PERCENT=20
MIN_PAYOUT_PKR=1000
CANCELLATION_FULL_REFUND_HOURS=24
CANCELLATION_PARTIAL_REFUND_HOURS=2
PARTIAL_REFUND_PERCENT=50
DROPPED_CALL_MAX_SECONDS=180
