  "issue_verifications": {
    "ISS-BUG-01": {
      "title": "Missing @login_required crashes /prescriptions/view/<id>",
      "status": "CONFIRMED",
      "http_status": 500,
      "evidence": "Unauthenticated GET /prescriptions/view/1 triggers HTTP 500 AttributeError: 'NoneType' object has no attribute 'role'"
    },
    "ISS-SEC-03": {
      "title": "Unauthenticated access to sensitive health documents in /static/uploads/",
      "status": "CONFIRMED",
      "evidence": "Direct GET without session returns HTTP 200 (generic upload) and HTTP 200 (medical document)"
    },
    "ISS-SEC-01": {
      "title": "Global CSRF Protection Disabled (WTF_CSRF_ENABLED = False)",
      "status": "CONFIRMED",
      "evidence": "POST /newsletter with no CSRF token accepted with HTTP 200 (redirect), not rejected with 400"
    },
    "ISS-FE-01": {
      "title": "Unclosed container div in base.html lines 413-502",
      "status": "CONFIRMED",
      "evidence": "<div class='container'> opened at line 413, navbar-collapse closed at line 501, navbar closed at line 502 without closing container div. Mobile screenshot 02_landing_mobile.png captured."
    },
    "ISS-BUG-02": {
      "title": "Timezone Desynchronization (datetime.now() vs get_pakistan_time())",
      "status": "CONFIRMED",
      "evidence": "Static analysis reveals datetime.utcnow() in patients.py:237,474,966; datetime.now() in patients.py:836 and check_expired_appointments.py:22 vs get_pakistan_now() in timezone.py."
    },
    "ISS-DEP-01": {
      "title": "Missing xhtml2pdf dependency in requirements.txt",
      "status": "CONFIRMED_AND_RESOLVED",
      "evidence": "With xhtml2pdf installed in venv, authenticated download returns HTTP 200, Content-Type: application/pdf, PDF Size: 6331 bytes."
    },
    "ISS-SEC-05": {
      "title": "Stored Cross-Site Scripting (XSS) in Doctor Blog Submissions",
      "status": "CONFIRMED",
      "evidence": "Doctor blog #13 content was rendered raw in /blogs/13 with Jinja '| safe' filter. Unsanitized markup found in response body: True."
    }
  },
